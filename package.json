{
  "name": "libra-library-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Libra — a complete school library management platform",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"NODE_NO_WARNINGS=1 tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist-server/index.js",
    "seed": "tsx server/seed/index.ts --force",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "resume": "node scripts/resume.mjs",
    "dev:resume": "node scripts/resume.mjs",
    "test": "vitest run",
    "reset": "tsx scripts/reset-data.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.59.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "jsbarcode": "^3.11.6",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.5"
  }
}
