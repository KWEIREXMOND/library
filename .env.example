# ── Libra configuration ─────────────────────────────────────────────
# Copy to .env and adjust for your school / deployment.

PORT=4000
NODE_ENV=development

# Long random string used to sign session tokens (required in production)
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Local SQLite file and uploaded digital resources (used when no hosted DB is set)
DATA_DIR=./data

# Optional hosted database (Turso). Leave blank to use the local SQLite file.
# Hosted libSQL (Turso). Leave both empty to use DATA_DIR/libra.db.
# LIBSQL_URL=libsql://your-database.turso.io
# LIBSQL_AUTH_TOKEN=
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Vercel Blob store id (hosted uploads). On Vercel this is injected by the store connection.
# BLOB_STORE_ID=

# Public URL of the site (used in password-reset emails)
APP_URL=http://localhost:5173

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Optional: outbound email for notifications. Without it, email deliveries are
# logged as failed while every notification stays available in-app.
# SMTP_URL=smtps://library%40tema.edu.gh:app-password@smtp.gmail.com:465
# MAIL_FROM="Tema Secondary Library <library@tema.edu.gh>"

# Extra browser origins allowed to call the API (comma separated). Same-origin
# requests are always allowed.
# ALLOWED_ORIGINS=https://library.tema.edu.gh

# Where the built frontend lives (production only)
# CLIENT_DIST=./dist

# Create the demo library when the database is empty. Set to false after launch
# so a wiped database never recreates the demo logins.
AUTO_SEED=true
